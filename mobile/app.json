{
  "expo": {
    "name": "NutriCoach",
    "slug": "nutricoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.personal.nutricoach",
      "infoPlist": {
        "NSCameraUsageDescription": "NutriCoach uses your camera to scan food barcodes",
        "NSPhotoLibraryUsageDescription": "NutriCoach saves progress photos to your library"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.personal.nutricoach",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": [
      [
        "expo-camera",
        { "cameraPermission": "Allow NutriCoach to access your camera to scan barcodes." }
      ],
      "expo-notifications"
    ]
  }
}
